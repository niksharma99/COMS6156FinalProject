# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored so your secrets never get committed.

# Anthropic API key — used by rag_eval.ipynb for generation and by both
# notebooks for the LLM-as-judge rubric. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# (Optional) HuggingFace token — only needed if you swap the baseline for a
# gated model such as meta-llama/Llama-3.2-3B-Instruct. Qwen2.5-3B is open.
HF_TOKEN=

# (Optional) OpenAI API key — only needed if you swap the RAG generator to
# OpenAI instead of Anthropic.
OPENAI_API_KEY=
